{
  "name": "dsh-document-translate",
  "version": "0.1.0",
  "description": "DocuTranslate-backed document translation tool for DeepSeek Harness (explicit translate_document tool over a LAN DocuTranslate service).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.ts",
    "smoke": "npm run build && node scripts/live-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.0.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0",
    "@firecrawl/anydoc": "^0.2.4",
    "@firecrawl/pdf-inspector": "^1.25.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
